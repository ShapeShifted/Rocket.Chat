# --- Stage 1: Builder ---
# Updated to Node 22 to match Meteor 3.x requirements
FROM node:22-bullseye AS builder

ENV LANG=C.UTF-8
ENV METEOR_ALLOW_SUPERUSER=1

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Meteor (Meteor 3 is automatically installed for Rocket.Chat 7+)
RUN curl https://install.meteor.com/ | sh

COPY . /app

# Fake a git repo if one doesn't exist to satisfy versioning requirements
RUN cd /app && \
    (git rev-parse --is-inside-work-tree || (git init && git config user.email "build@rocket.chat" && git config user.name "Builder" && git add . && git commit -m "Build"))

# Build the Meteor app
RUN cd /app/apps/meteor \
    && rm -rf .meteor/local \
    && NODE_OPTIONS="--max-old-space-size=8192" meteor build --server-only --directory /app/bundle --allow-superuser

# --- Stage 2: Dependency Compilation ---
FROM node:22-bullseye-slim AS deps-compiler

# Install build tools for native modules (like sharp/bcrypt)
RUN apt-get update && apt-get install -y \
    python3 make g++ gcc libc6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/bundle /app/bundle

# Install production dependencies
RUN cd /app/bundle/bundle/programs/server \
    && npm install --omit=dev

# --- Stage 3: Final Runtime ---
# Using Node 22 as required by Rocket.Chat 7.0+ / Meteor 3.0
FROM node:22-bullseye-slim

LABEL maintainer="buildmaster@rocket.chat"

ENV LANG=C.UTF-8 \
    DEPLOY_METHOD=docker \
    NODE_ENV=production \
    MONGO_URL=mongodb://mongo:27017/rocketchat \
    HOME=/tmp \
    PORT=3000 \
    ROOT_URL=http://localhost:3000 \
    Accounts_AvatarStorePath=/app/uploads

# Setup user and permissions
RUN groupadd -r rocketchat && useradd -r -g rocketchat rocketchat \
    && mkdir -p /app/uploads \
    && chown rocketchat:rocketchat /app/uploads

USER rocketchat

COPY --from=deps-compiler --chown=rocketchat:rocketchat /app/bundle/bundle /app/bundle

WORKDIR /app/bundle

EXPOSE 3000

CMD ["node", "main.js"]